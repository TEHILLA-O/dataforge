{
  "name": "dataforge-aws",
  "version": "1.0.0",
  "description": "DataForge — AWS real-time data lakehouse, streaming analytics and governance platform",
  "private": true,
  "bin": {
    "dataforge": "cli/dataforge/bin/dataforge.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json -w",
    "cdk": "cdk",
    "synth": "cdk synth -c env=dev",
    "synth:stage": "cdk synth -c env=stage",
    "synth:prod": "cdk synth -c env=prod",
    "diff": "cdk diff -c env=dev",
    "deploy:dev": "cdk deploy --all -c env=dev --require-approval never",
    "deploy:stage": "cdk deploy --all -c env=stage",
    "deploy:prod": "cdk deploy --all -c env=prod",
    "destroy:dev": "cdk destroy --all -c env=dev --force",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "dataforge": "ts-node --prefer-ts-exts cli/dataforge/src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.700.0",
    "@aws-sdk/client-cloudformation": "^3.700.0",
    "@aws-sdk/client-cloudwatch": "^3.700.0",
    "@aws-sdk/client-cost-explorer": "^3.700.0",
    "@aws-sdk/client-glue": "^3.700.0",
    "@aws-sdk/client-kinesis": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "aws-cdk-lib": "^2.178.1",
    "commander": "^12.1.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "aws-cdk": "^2.178.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
